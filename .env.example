# Copy to .env.local and fill in. .env.local is git-ignored.

# Qloo hackathon key. Leave empty to run on SYNTHETIC mock data.
QLOO_API_KEY=
# Force mock mode even when a key is set: QLOO_MODE=mock
QLOO_MODE=

# Pretaste's own Anthropic key. ANTHROPIC_API_KEY is intentionally NOT read.
# Leave empty to run "offline" on prepared fixtures.
PRETASTE_ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5-5)
PRETASTE_MODEL=

# Optional: file cache for live Qloo responses (.cache/qloo, git-ignored). Default: memory.
PRETASTE_CACHE=

# Optional: soft daily budget of live LLM calls (default 400, about 4 per run; 0 = none).
# Never blocks a request: past it, the LLM steps use prepared fixtures and Qloo checks keep running.
PRETASTE_LLM_CALLS_PER_DAY=
